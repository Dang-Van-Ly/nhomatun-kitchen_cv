# Build stage
FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /app

# Copy local JARs
COPY libs/ ./libs/

# Install local JARs into Maven local repository
RUN mvn install:install-file -Dfile=libs/TimingFramework-0.55.jar \
        -DgroupId=com.timingsystem -DartifactId=TimingFramework \
        -Dversion=0.55 -Dpackaging=jar -q && \
    mvn install:install-file -Dfile=libs/swing-time-picker.jar \
        -DgroupId=swing-time-picker -DartifactId=swing-time-picker \
        -Dversion=1 -Dpackaging=jar -q

COPY pom.xml .
# Download dependencies (cache layer)
RUN mvn dependency:go-offline -q 2>/dev/null || true

COPY src ./src
RUN mvn clean package -DskipTests -q

# Extract Spring Boot fat JAR để chạy class tùy chỉnh
RUN mkdir -p /app/extracted && \
    cd /app/extracted && \
    jar xf /app/target/*.jar

# Runtime stage
FROM eclipse-temurin:21-jdk-jammy
WORKDIR /app

# Copy extracted JAR contents
COPY --from=builder /app/extracted/ ./

EXPOSE 7551
# Chạy RMIServer với classpath đầy đủ từ Spring Boot fat JAR đã extract
# Dấu chấm (.) để tìm META-INF/persistence.xml ở root
ENTRYPOINT ["java", \
    "-cp", ".:BOOT-INF/classes:BOOT-INF/lib/*", \
    "rmi.RMIServer"]
